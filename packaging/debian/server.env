# psk-server startup arguments (/etc/psk-quic-proxy/server.env).
#
# This is a dpkg conffile: upgrades do not overwrite your edits.
# See `psk-server --help` for the available arguments.
#
# Minimal configuration (replace the key):
#
#   PSK_ARGS=--psk CHANGE-ME
#
# Prefer reading the key from a file so it stays out of the process list.
# Create the file 0600 and let the pskproxy user read it:
#
#   install -o pskproxy -g pskproxy -m 0600 /dev/null /etc/psk-quic-proxy/psk
#   printf '%s' 'CHANGE-ME' > /etc/psk-quic-proxy/psk
#   PSK_ARGS=--psk @/etc/psk-quic-proxy/psk
#
# Listen address defaults to 0.0.0.0:4433; --allow-private lets the server
# reach loopback/private targets (needed only for internal use).
#
# Then:
#   systemctl enable --now psk-quic-proxy
#   journalctl -u psk-quic-proxy -f

PSK_ARGS=

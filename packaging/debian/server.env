# tuic-proxy-server startup arguments (/etc/tuic-proxy/server.env).
#
# This is a dpkg conffile: upgrades do not overwrite your edits.
# See `tuic-proxy-server --help` for the available arguments.
#
# Minimal configuration (replace the key):
#
#   PSK_ARGS=--psk CHANGE-ME
#
# Prefer reading the key from a file so it stays out of the process list.
# Create the file 0600 and let the tuicproxy user read it:
#
#   install -o tuicproxy -g tuicproxy -m 0600 /dev/null /etc/tuic-proxy/psk
#   printf '%s' 'CHANGE-ME' > /etc/tuic-proxy/psk
#   PSK_ARGS=--psk @/etc/tuic-proxy/psk
#
# Listen address defaults to 0.0.0.0:4433; --allow-private lets the server
# reach loopback/private targets (needed only for internal use).
#
# Then:
#   systemctl enable --now tuic-proxy
#   journalctl -u tuic-proxy -f

PSK_ARGS=

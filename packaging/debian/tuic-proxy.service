[Unit]
Description=TUIC Proxy QUIC server
Documentation=file:///usr/share/doc/tuic-proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The service never needs privileges: it only does UDP and outbound TCP.
User=tuicproxy
Group=tuicproxy

# Startup arguments come from /etc/tuic-proxy/server.env (a dpkg conffile).
# The unit does not start on install: without PSK_ARGS the server exits with
# "the following required arguments were not provided: --psk".
# Note: $PSK_ARGS is split at whitespace by systemd, so it can carry several
# arguments such as `--psk @/etc/tuic-proxy/psk --allow-private`.
EnvironmentFile=-/etc/tuic-proxy/server.env
ExecStart=/usr/bin/tuic-proxy-server $PSK_ARGS

Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

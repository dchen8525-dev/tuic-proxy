* text=auto

# Shell/Python/systemd files must keep LF endings (they run on Linux).
*.sh       text eol=lf
*.py       text eol=lf
*.service  text eol=lf
*.env      text eol=lf
postinst   text eol=lf
prerm      text eol=lf
postrm     text eol=lf
copyright  text eol=lf
*.yml      text eol=lf

# Binary artifacts
*.deb      binary
*.exe      binary

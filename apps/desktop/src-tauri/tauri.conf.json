{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuic-proxy-gui",
  "version": "0.2.0",
  "identifier": "com.tuic.proxy",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TUIC 代理",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tuic-proxy-client"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "TUIC 代理客户端",
    "longDescription": "TUIC Proxy 客户端：本地 SOCKS5 入口，经 PSK 认证的 QUIC 隧道转发。便携版，不安装。"
  },
  "mainBinaryName": "tuic-proxy-gui"
}